# 从自己的 EVE 开发者应用填写；空值不是可用凭据。
EVE_CLIENT_ID=
EVE_CLIENT_SECRET=
EVE_CALLBACK_URL=http://localhost:8000/auth/callback

# 按 README 分别生成；不要复制别人提供的密钥，也不要每次启动重新生成。
APP_SESSION_SECRET=
APP_ENCRYPTION_KEY=
DATABASE_PATH=data/eve_income.sqlite3

# 将示例邮箱替换成自己的有效联系方式。
EVE_USER_AGENT=eve-income-tracker/0.1 (your-email@example.com)
ESI_COMPATIBILITY_DATE=2026-05-19
